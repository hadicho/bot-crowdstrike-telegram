# Salin file ini menjadi ".env" (tanpa .example) lalu isi nilainya.
# JANGAN commit file ".env" ke git — tambahkan ke .gitignore.

TELEGRAM_TOKEN=ISI_TOKEN_TELEGRAM_ANDA
# Bisa lebih dari satu Chat ID, dipisah koma (tanpa spasi ekstra)
ALLOWED_CHAT_IDS=123456789,987654321
FALCON_CLIENT_ID=ISI_CLIENT_ID_CROWDSTRIKE
FALCON_SECRET=ISI_SECRET_CROWDSTRIKE

# Sesuaikan dengan region cloud CrowdStrike Anda:
# US-1:      https://api.crowdstrike.com
# US-2:      https://api.us-2.crowdstrike.com
# EU-1:      https://api.eu-1.crowdstrike.com
# US-GOV-1:  https://api.laggar.gcw.crowdstrike.com
FALCON_BASE_URL=https://api.crowdstrike.com